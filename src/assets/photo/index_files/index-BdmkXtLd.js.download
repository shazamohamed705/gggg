        }
        
        .home-page {
          position: relative;
          overflow-x: hidden !important;
        }
        
        .home-page .hero-section {
          margin-top: ${t?"46px":"0"} !important;
          transition: margin-top 0.3s ease !important;
        }
        
        .home-page section {
          clear: both;
          position: relative;
        }
        
        .booking-card {
